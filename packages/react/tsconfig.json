{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"declaration": true,
		"isolatedDeclarations": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "test"]
}
