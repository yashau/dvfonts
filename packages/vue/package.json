	"keywords": [
		"dhivehi",
		"divehi",
		"fonts",
		"keyboard",
		"maldives",
		"nuxt",
		"rtl",
		"thaana",
		"vue"
	],
	"homepage": "https://fonts.mv/docs",
	"license": "MIT",
	"author": "Ibrahim Yashau",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yashau/dvfonts.git",
		"directory": "packages/vue"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
