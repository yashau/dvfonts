{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dvfonts",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// All binaries (fonts/…, downloads/…) live in R2; built by fonts/scripts, uploaded by deploy.yml.
	"r2_buckets": [{ "binding": "STATIC", "bucket_name": "dvfonts-static" }],
	// Must match SITE_ORIGIN in src/lib/site.ts and DVFONTS_ORIGIN in @yashau/thaana.
	"routes": [{ "pattern": "dvfonts.yashau.com", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true }
}
